# Server-only values
LLM_API_URL=https://your-provider.example/v1/chat/completions
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini
PORT=8787
FRONTEND_ORIGIN=http://localhost:5173

# Frontend build-time value. Omit it for the bundled local guide release.
# VITE_GUIDE_MANIFEST_URL=https://cdn.krishi.example/guides/manifest.json

# Leave VITE_API_URL unset for a single Render Web Service. The frontend will
# then call its own /api endpoints. For separate local processes, use:
# VITE_API_URL=http://localhost:8787
